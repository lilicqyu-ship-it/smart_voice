# Target / flash
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# CPU / RTOS
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# PSRAM (octal, 8MB)
# NOTE: 80MHz is the highest *stable* speed for octal PSRAM; IDF marks 120MHz
# for octal as experimental (random crashes with temperature drift).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# The S3 hardware AES DMA path needs a contiguous internal/DMA buffer while
# TLS is uploading PSRAM-backed audio.  Software AES avoids that transient
# allocation and is fast enough at 240 MHz for this voice workload.
CONFIG_MBEDTLS_HARDWARE_AES=n
# XIP: code+rodata run from PSRAM so flash writes (NVS, Wi-Fi PHY calibration)
# no longer disable the cache. Without it the RGB bounce ISR cannot read the
# PSRAM framebuffer during a flash op and the panel drifts / shows snow.
# (Proven on this exact board in the smartcar_remote project.)
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# 64KB / 64B-line / 8-way data cache for PSRAM->bounce-buffer memcpy bandwidth.
# Legal here because bounce-buffer mode is enabled (see BSP warning otherwise).
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_8WAYS=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# BSP: ESP32-S3-LCD-EV-Board, LCD sub-board 3 (800x480 ST7262 + GT1151)
# Anti-tearing: LVGL renders into vsync-synchronized RGB framebuffers.
# DIRECT_MODE (not FULL_REFRESH): full refresh repaints the whole 800x480 for
# every dirty pixel group, which strobes the panel; direct mode redraws only
# the dirty regions into the vsync-synchronized buffer.
# BUFFER_NUMS=3 + bounce 20: the proven config for this board
# (smartcar_remote / esp-dev-kits lvgl_demos).
CONFIG_BSP_LCD_SUB_BOARD_800_480=y
CONFIG_BSP_LCD_RGB_BUFFER_NUMS=3
CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_MODE=y
CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_HEIGHT=20
CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR=y
CONFIG_BSP_DISPLAY_LVGL_DIRECT_MODE=y

# LVGL: render as soon as a frame is dirty - the 35 Hz panel vsync (direct-mode
# flush waits for it) is the real cap.
CONFIG_LV_DEF_REFR_PERIOD=16

# Keep lwIP off core 1, where the LVGL task is pinned (see app_ui.c).
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# esp-sr wake-word model retained for the local audio front end.
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
CONFIG_SR_MN_CN_NONE=y

# LVGL 9
CONFIG_LV_COLOR_DEPTH=16
# Our CJK font has >1MB of glyph bitmaps, widen the glyph descriptors.
CONFIG_LV_FONT_FMT_TXT_LARGE=y
# Chinese text uses the in-tree full-coverage font (main/fonts/font_cjk_20.c,
# generated by tools/gen_font.sh); the LVGL built-in CJK font only covers the
# 1000 most common characters and renders everything else as boxes.

#
# WiFi Station
#
# Fill in your own WiFi credentials via `idf.py menuconfig`
# (Smart Voice Configuration), they are not stored in this file.
CONFIG_SMART_VOICE_WIFI_SSID="your-ssid"
CONFIG_SMART_VOICE_WIFI_PASSWORD="your-password"
# end of WiFi Station

# Fill in your own AI service API key via `idf.py menuconfig`.
CONFIG_SMART_VOICE_AI_API_KEY="your-api-key"
# Internal RAM budget: the RGB bounce buffers, I2S DMA and task stacks live in
# internal SRAM; the stock WiFi buffer pool (~50 KB static) exhausted it before
# esp_wifi_init (boot loop: wifi:malloc buffer fail -> NO_MEM).  Voice-app
# traffic is light, so shrink the pools; dynamic rx can spill to PSRAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_LV_MEM_SIZE=49152
CONFIG_ESP_WIFI_RX_BA_WIN=6
